+name: Component 08 verifier validation
+
+on:
+  push:
+    branches:
+      - agent/bounded-manifold-mesh-boolean-plan
+
+permissions:
+  contents: read
+
+jobs:
+  verifier:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+      - name: Configure strict C++17 build
+        run: >-
+          cmake -S . -B build
+          -DCMAKE_BUILD_TYPE=Release
+          -DBUILD_TESTING=ON
+          -DMEMORY_CONSTRAINED_BUILD=ON
+          -DWITH_EIGEN=OFF
+          -DWITH_GNU_GSL=OFF
+      - name: Build Component 08 verifier target
+        run: >-
+          cmake --build build
+          --target ygor_mesh_boolean_intersection_verifier_tests
+          --parallel 2
+      - name: Run Component 08 verifier regression
+        run: >-
+          ctest --test-dir build --output-on-failure
+          -R '^mesh_boolean_bounded_component08_verifier$'
