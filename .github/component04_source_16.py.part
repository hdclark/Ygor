

# Correct the property fixture for Ygor's vec3 carrier, which exposes x/y/z
# and indexed access but intentionally does not provide range iteration.
property_test = Path('tests/mesh_boolean_bounded/TestSourceTriangulationProperties.cc')
property_text = property_test.read_text()
property_old = '''    for (auto &vertex : mesh.vertices)
      for (auto &coordinate : vertex)
        coordinate = coordinate * scale + double(iteration * 4);'''
property_new = '''    for (auto &vertex : mesh.vertices) {
      vertex.x = vertex.x * scale + double(iteration * 4);
      vertex.y = vertex.y * scale + double(iteration * 4);
      vertex.z = vertex.z * scale + double(iteration * 4);
    }'''
if property_text.count(property_old) != 1:
    raise SystemExit('property fixture vec3 loop missing or duplicated')
property_test.write_text(property_text.replace(property_old, property_new, 1))
