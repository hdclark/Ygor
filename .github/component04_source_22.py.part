
# The artifact digest includes the replay-presentation correspondence by design.
# Presentation permutations must preserve the semantic and exact-layout digests,
# while the outer replay wrapper may legitimately differ.
canonical_test = Path('tests/mesh_boolean_bounded/TestSourceTriangulationCanonicalization.cc')
canonical_text = canonical_test.read_text()
canonical_old = '''  require((*first.value())->digest() == (*second.value())->digest(),
          "presentation permutations preserve exact V1 artifact");'''
canonical_new = '''  require((*first.value())->exact_triangulation_digest() ==
              (*second.value())->exact_triangulation_digest(),
          "presentation permutations preserve exact V1 triangulation layout");'''
if canonical_text.count(canonical_old) != 1:
    raise SystemExit('canonical presentation assertion missing or duplicated')
canonical_test.write_text(canonical_text.replace(canonical_old, canonical_new, 1))
