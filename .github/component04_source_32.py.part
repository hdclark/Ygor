
# Shared collinear endpoints are contacts, not positive-length overlaps.  Keep
# non-shared interval overlap fail-closed, and attach stable independent-verifier
# finding codes to any remaining publication rejection.
kernel = Path('src/YgorMeshesBooleanBounded/BoundedSourcePolygonKernel.h')
kernel_text = kernel.read_text()
old_collinear = '''    if (x == 0 && y == 0 && z == 0 && w == 0)
      return bounded_segment_relation::collinear_overlap;
    if ((x == 0 && !source_polygon_kernel_detail::point_box_disjoint(c, a, b)) ||'''
new_collinear = '''    if (x == 0 && y == 0 && z == 0 && w == 0) {
      const bool shared_endpoint =
          a.source_vertex == c.source_vertex || a.source_vertex == d.source_vertex ||
          b.source_vertex == c.source_vertex || b.source_vertex == d.source_vertex;
      return shared_endpoint ? bounded_segment_relation::endpoint_contact
                             : bounded_segment_relation::collinear_overlap;
    }
    if ((x == 0 && !source_polygon_kernel_detail::point_box_disjoint(c, a, b)) ||'''
if kernel_text.count(old_collinear) != 1:
    raise SystemExit('collinear source segment relation site missing')
kernel.write_text(kernel_text.replace(old_collinear, new_collinear, 1))

triangulation = Path('src/YgorMeshesBooleanBounded/SourceTriangulation.h')
triangulation_text = triangulation.read_text()
start_marker = '''template <class T, class I>
bool independent_topology_verification('''
end_marker = '''  return true;
}

} // namespace source_triangulation_detail'''
start = triangulation_text.find(start_marker)
end = triangulation_text.find(end_marker, start)
if start < 0 or end < 0:
    raise SystemExit('independent source triangulation verifier boundaries missing')
end += len('''  return true;
}''')
section = triangulation_text[start:end]
old_signature_tail = '''    const precision_context<T> &precision,
    bool include_witnesses) {'''
new_signature_tail = '''    const precision_context<T> &precision,
    bool include_witnesses,
    std::uint32_t *failure_code = nullptr) {'''
if section.count(old_signature_tail) != 1:
    raise SystemExit('independent verifier signature tail missing')
section = section.replace(old_signature_tail, new_signature_tail, 1)

finding = 4100
parts = section.split('return false;')
if len(parts) < 2:
    raise SystemExit('independent verifier has no rejection sites')
rebuilt = parts[0]
for part in parts[1:]:
    rebuilt += f'return reject({finding});' + part
    finding += 1
section = rebuilt
open_brace = section.find(new_signature_tail) + len(new_signature_tail)
section = (section[:open_brace] + '''
  const auto reject = [failure_code](std::uint32_t code) noexcept {
    if (failure_code)
      *failure_code = code;
    return false;
  };''' + section[open_brace:])
triangulation_text = triangulation_text[:start] + section + triangulation_text[end:]

old_prepublication = '''    if (!source_triangulation_detail::independent_topology_verification(
            out_, *operand_, precision_, true))
      return failure(source_triangulation_subcode::verifier_rejection,
                     bounded_boolean_error_category::internal_invariant_error,
                     "independent source triangle complex verifier rejected artifact",
                     source_triangulation_checkpoint::independent_verification);'''
new_prepublication = '''    std::uint32_t verifier_finding = 0;
    if (!source_triangulation_detail::independent_topology_verification(
            out_, *operand_, precision_, true, &verifier_finding)) {
      auto error = source_triangulation_error(
          operand_->operand(), source_triangulation_subcode::verifier_rejection,
          bounded_boolean_error_category::internal_invariant_error,
          "independent source triangle complex verifier rejected artifact",
          source_triangulation_checkpoint::independent_verification);
      error.context_digest = precision_.digest();
      error.replay_digest = context_.replay_digest;
      error.witnesses[0] = verifier_finding;
      error.witness_count = 1;
      return boolean_outcome<std::shared_ptr<const artifact_type>>::failure(error);
    }'''
if triangulation_text.count(old_prepublication) != 1:
    raise SystemExit('source triangulation pre-publication verifier site missing')
triangulation_text = triangulation_text.replace(old_prepublication,
                                                new_prepublication, 1)
triangulation.write_text(triangulation_text)

fixtures = Path('tests/mesh_boolean_bounded/SourceTriangulationFixtures.h')
fixture_text = fixtures.read_text()
old_helper = '''  return bounded::triangulate_source_operand(fixture.operand, fixture.context,
                                              *fixture.precision, capabilities);'''
new_helper = '''  auto result = bounded::triangulate_source_operand(
      fixture.operand, fixture.context, *fixture.precision, capabilities);
  if (!result.has_value()) {
    std::string diagnostic = result.error()->summary;
    diagnostic += " [subcode " + std::to_string(result.error()->subcode);
    if (result.error()->witness_count != 0)
      diagnostic += ", finding " +
                    std::to_string(result.error()->witnesses[0]);
    diagnostic += "]";
    throw std::runtime_error(diagnostic);
  }
  return result;'''
if fixture_text.count(old_helper) != 1:
    raise SystemExit('source triangulation fixture helper return site missing')
fixtures.write_text(fixture_text.replace(old_helper, new_helper, 1))
