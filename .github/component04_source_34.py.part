
# A canonical interval for numerical zero is [-0,+0], intentionally not a
# total-order singleton.  Segment predicates may still use it as a definite
# collinearity proof when the exact nominal predicate also reports zero.
kernel = Path('src/YgorMeshesBooleanBounded/BoundedSourcePolygonKernel.h')
kernel_text = kernel.read_text()
old_zero = '''      if (evidence.exact_sign == 0 && evidence.determinant.is_singleton())
        return 0;'''
new_zero = '''      if (evidence.exact_sign == 0 &&
          evidence.determinant.lower() == T(0) &&
          evidence.determinant.upper() == T(0))
        return 0;'''
if kernel_text.count(old_zero) != 1:
    raise SystemExit('definite zero segment-orientation site missing')
kernel.write_text(kernel_text.replace(old_zero, new_zero, 1))
