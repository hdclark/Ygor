# Source-identity is exact topology.  When an orientation input reuses the
# same retained source vertex, the determinant is identically zero even when
# interval subtraction of the shared endpoint does not collapse to a singleton.
# Preserve bounded uncertainty for distinct identities.
replace_once(
    'src/YgorMeshesBooleanBounded/BoundedSourcePolygonKernel.h',
    r'''    const auto value = [](const source_orientation_evidence<T> &evidence) {
      if (evidence.bounded_sign == bounded_planar_sign::negative)
        return -1;
      if (evidence.bounded_sign == bounded_planar_sign::positive)
        return 1;
      // A singleton zero enclosure is a definite collinearity statement.  It is
      // still ineligible as an ear orientation, but it is sufficient to prove a
      // segment contact or a disjoint collinear ordering.
      if (evidence.exact_sign == 0 &&
          evidence.determinant.lower() == T(0) &&
          evidence.determinant.upper() == T(0))
        return 0;
      return 2;
    };
    const int x = value(ab_c), y = value(ab_d), z = value(cd_a), w = value(cd_b);''',
    r'''    const auto value = [](const source_orientation_evidence<T> &evidence,
                           bool identity_zero) {
      if (identity_zero)
        return 0;
      if (evidence.bounded_sign == bounded_planar_sign::negative)
        return -1;
      if (evidence.bounded_sign == bounded_planar_sign::positive)
        return 1;
      // A singleton zero enclosure is a definite collinearity statement.  It is
      // still ineligible as an ear orientation, but it is sufficient to prove a
      // segment contact or a disjoint collinear ordering.
      if (evidence.exact_sign == 0 &&
          evidence.determinant.lower() == T(0) &&
          evidence.determinant.upper() == T(0))
        return 0;
      return 2;
    };
    const int x = value(ab_c, c.source_vertex == a.source_vertex ||
                                   c.source_vertex == b.source_vertex);
    const int y = value(ab_d, d.source_vertex == a.source_vertex ||
                                   d.source_vertex == b.source_vertex);
    const int z = value(cd_a, a.source_vertex == c.source_vertex ||
                                   a.source_vertex == d.source_vertex);
    const int w = value(cd_b, b.source_vertex == c.source_vertex ||
                                   b.source_vertex == d.source_vertex);''')

# The full precision-context digest contains source-presentation, context-owner,
# and replay bindings.  Keep it in the artifact for runtime contract validation,
# but do not let those bindings contaminate owner-free semantic identity.
replace_once(
    'src/YgorMeshesBooleanBounded/SourceTriangulation.h',
    r'''  write_digest(writer, artifact.predecessor_digest());
  write_digest(writer, artifact.precision_digest());
  writer.u64(artifact.vertices().size());''',
    r'''  write_digest(writer, artifact.predecessor_digest());
  writer.u64(artifact.vertices().size());''')

# Likewise, a facet geometry-basis digest commits the actual source identities,
# projected carriers, finite enclosures, formulas, and predecessor semantics;
# the presentation-bound precision-context digest remains a separately validated
# reference and is carried by replay rather than exact triangulation identity.
replace_once(
    'src/YgorMeshesBooleanBounded/SourceTriangulation.h',
    r'''  write_digest(writer, out.basis.predecessor_digest);
  write_digest(writer, out.basis.precision_digest);
  writer.u64(out.points.size());''',
    r'''  write_digest(writer, out.basis.predecessor_digest);
  writer.u64(out.points.size());''')

replace_once(
    'src/YgorMeshesBooleanBounded/SourceTriangulation.h',
    r'''    source_triangulation_detail::write_digest(
        replay, operand_->source_presentation_digest());
    replay.u16(contract_versions::source_triangle_complex_codec);''',
    r'''    source_triangulation_detail::write_digest(
        replay, operand_->source_presentation_digest());
    source_triangulation_detail::write_digest(replay, precision_.digest());
    replay.u16(contract_versions::source_triangle_complex_codec);''')
