# Source-identity is exact topology.  When an orientation input reuses the
# same retained source vertex, the determinant is identically zero even when
# interval subtraction of the shared endpoint does not collapse to a singleton.
# Preserve bounded uncertainty for distinct identities.
replace_once(
    'src/YgorMeshesBooleanBounded/BoundedSourcePolygonKernel.h',
    r'''    const auto value = [](const source_orientation_evidence<T> &evidence) {
      if (evidence.bounded_sign == bounded_planar_sign::negative)
        return -1;
      if (evidence.bounded_sign == bounded_planar_sign::positive)
        return 1;
      // A singleton zero enclosure is a definite collinearity statement.  It is
      // still ineligible as an ear orientation, but it is sufficient to prove a
      // segment contact or a disjoint collinear ordering.
      if (evidence.exact_sign == 0 &&
          evidence.determinant.lower() == T(0) &&
          evidence.determinant.upper() == T(0))
        return 0;
      return 2;
    };
    const int x = value(ab_c), y = value(ab_d), z = value(cd_a), w = value(cd_b);''',
    r'''    const auto value = [](const source_orientation_evidence<T> &evidence,
                           bool identity_zero) {
      if (identity_zero)
        return 0;
      if (evidence.bounded_sign == bounded_planar_sign::negative)
        return -1;
      if (evidence.bounded_sign == bounded_planar_sign::positive)
        return 1;
      // A singleton zero enclosure is a definite collinearity statement.  It is
      // still ineligible as an ear orientation, but it is sufficient to prove a
      // segment contact or a disjoint collinear ordering.
      if (evidence.exact_sign == 0 &&
          evidence.determinant.lower() == T(0) &&
          evidence.determinant.upper() == T(0))
        return 0;
      return 2;
    };
    const int x = value(ab_c, c.source_vertex == a.source_vertex ||
                                   c.source_vertex == b.source_vertex);
    const int y = value(ab_d, d.source_vertex == a.source_vertex ||
                                   d.source_vertex == b.source_vertex);
    const int z = value(cd_a, a.source_vertex == c.source_vertex ||
                                   a.source_vertex == d.source_vertex);
    const int w = value(cd_b, b.source_vertex == c.source_vertex ||
                                   b.source_vertex == d.source_vertex);''')

# Temporary differential diagnostic for the remaining canonicalization failure.
replace_once(
    'tests/mesh_boolean_bounded/TestSourceTriangulationCanonicalization.cc',
    r'''  require((*first.value())->source_semantic_digest() ==
              (*second.value())->source_semantic_digest(),
          "presentation permutations preserve source semantics");''',
    r'''  if ((*first.value())->source_semantic_digest() !=
      (*second.value())->source_semantic_digest()) {
    const auto &a = (*first.value())->semantic_bytes();
    const auto &b = (*second.value())->semantic_bytes();
    std::size_t first_difference = std::min(a.size(), b.size());
    for (std::size_t i = 0; i < std::min(a.size(), b.size()); ++i)
      if (a[i] != b[i]) { first_difference = i; break; }
    throw std::runtime_error(
        std::string("canonical diagnostic: operand_digest=") +
        std::to_string(first_fixture.operand->digest() == second_fixture.operand->digest()) +
        " source_digest=" +
        std::to_string(first_fixture.operand->source_digest() == second_fixture.operand->source_digest()) +
        " operand_bytes=" +
        std::to_string(first_fixture.operand->canonical_bytes() == second_fixture.operand->canonical_bytes()) +
        " predecessor=" +
        std::to_string((*first.value())->predecessor_digest() == (*second.value())->predecessor_digest()) +
        " vertices=" +
        std::to_string((*first.value())->vertices().size() == (*second.value())->vertices().size()) +
        " facets=" +
        std::to_string((*first.value())->facets().size() == (*second.value())->facets().size()) +
        " exact=" +
        std::to_string((*first.value())->exact_triangulation_digest() ==
                       (*second.value())->exact_triangulation_digest()) +
        " sizes=" + std::to_string(a.size()) + "/" + std::to_string(b.size()) +
        " diff=" + std::to_string(first_difference) +
        " stats=" +
        std::to_string(first_fixture.operand->statistics().triangle_pairs) + "/" +
        std::to_string(second_fixture.operand->statistics().triangle_pairs) + "," +
        std::to_string(first_fixture.operand->statistics().relation_calls) + "/" +
        std::to_string(second_fixture.operand->statistics().relation_calls) + "," +
        std::to_string(first_fixture.operand->statistics().canonical_branches) + "/" +
        std::to_string(second_fixture.operand->statistics().canonical_branches));
  }''')
